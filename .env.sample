# Copy to .env and fill in. Nothing here is a real credential.

# ── Database (SQLAlchemy + psycopg v3 driver — no psycopg2) ────────────────
DATABASE_URL=postgresql+psycopg://ingestion:ingestion@localhost:5433/ingestion_pipeline

# ── Blob storage (local dev backend archives raw bytes here) ───────────────
BLOB_STORE_BACKEND=local
BLOB_STORE_LOCAL_ROOT=./data/blobstore

# ── S3 (for the future S3 adapter — safe to leave blank for local dev today) ─
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=

# ── Embedding provider ──────────────────────────────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=100

# ── Retry policy ─────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=2.0

# ── Neo4j (entity/relationship consumer only — core pipeline never uses this) ─
# NEO4J_URI=bolt://localhost:7687
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
# Database that all graph data is written to (must already exist; Neo4j Enterprise/Aura: CREATE DATABASE ingest)
NEO4J_DATABASE=ingest
NEO4J_PASSWORD=12345678

# ── Entity/relationship extraction (chat-completion model, separate from the
#    embedding model above) ───────────────────────────────────────────────────
ENTITY_EXTRACTION_MODEL=gpt-4o-mini

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cognee (chunking, embeddings, entity extraction, graph + vector indexing) ─
# All optional: defaults fall back to the values above.
# COGNEE_LLM_MODEL=gpt-4o-mini            # default: ENTITY_EXTRACTION_MODEL
# COGNEE_LLM_API_KEY=                     # default: EMBEDDING_API_KEY
# EMBEDDING_DIMENSIONS=3072               # must match EMBEDDING_MODEL
# COGNEE_DATA_ROOT=./data/cognee
# Cognee isolates each dataset in its own Neo4j database by default, which needs Neo4j
# Enterprise/Aura. We share one graph instead; set to true ONLY on Enterprise/Aura.
# ENABLE_BACKEND_ACCESS_CONTROL=false

# ── Sign-in ───────────────────────────────────────────────────────────────────
# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# AUTH_SESSION_HOURS=72
# AUTH_COOKIE_SECURE=true                 # set when served over HTTPS
# First user, created at startup only if no users exist yet. Remove these two lines afterwards.
# ADMIN_EMAIL=you@company.com
# ADMIN_PASSWORD=choose-a-long-password
# More users later: uv run python -m ingestion_pipeline.cli create-user someone@company.com

# ── Nango (self-hosted; see docs/NANGO_SETUP.md) ──────────────────────────────
NANGO_BASE_URL=http://localhost:3003
NANGO_SECRET_KEY=
# How often connected accounts are checked for new data, how far back the first sync reaches,
# and how many items one check ingests (a bigger backlog continues on the next check).
# CONNECTOR_POLL_MINUTES=10
# CONNECTOR_INITIAL_DAYS=30
# CONNECTOR_MAX_ITEMS_PER_SCAN=100

# ── Chat ────────────────────────────────────────────────────────────────────
# Uses the same OpenAI key as above (COGNEE_LLM_API_KEY, else EMBEDDING_API_KEY).
CHAT_MODEL=gpt-4o-mini
CHAT_TOP_K=8
CHAT_HISTORY_TURNS=6
CHAT_USE_GRAPH=true

# ── Sign-up ─────────────────────────────────────────────────────────────────
# Anyone who can sign up can read the whole archive. Set an invite code, or ALLOW_SIGNUP=false to turn sign-up off.
ALLOW_SIGNUP=true
SIGNUP_INVITE_CODE=

# ── Gmail limit ─────────────────────────────────────────────────────────────
# How many emails to ingest per connected Gmail account (the newest ones within CONNECTOR_INITIAL_DAYS).
# Change it any time: raise it and press "Sync now" to bring in the next-newest ones. 0 = no limit.
GMAIL_MAX_MAILS=100
