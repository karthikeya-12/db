# Copy to .env and fill in. Nothing here is a real credential.

# ── Database (SQLAlchemy + psycopg v3 driver — no psycopg2) ────────────────
DATABASE_URL=postgresql+psycopg://ingestion:ingestion@localhost:5433/ingestion_pipeline

# ── Blob storage (local dev backend archives raw bytes here) ───────────────
BLOB_STORE_BACKEND=local
BLOB_STORE_LOCAL_ROOT=./data/blobstore

# ── S3 (for the future S3 adapter — safe to leave blank for local dev today) ─
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=

# ── Embedding provider ──────────────────────────────────────────────────────
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=100

# ── Retry policy ─────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=2.0

# ── Chunking (word-window strategy — DOCUMENT content) ──────────────────────
CHUNK_MIN_WORDS=400
CHUNK_MAX_WORDS=500
CHUNK_OVERLAP_WORDS=50

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
